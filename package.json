{
  "name": "genshin-ts",
  "version": "0.2.0",
  "description": "Use Typescript to develop Genshin UGC - Miliastra Wonderland",
  "type": "module",
  "author": "josStorer <josstorer@outlook.com> (https://github.com/josStorer)",
  "homepage": "https://gsts.moe",
  "repository": {
    "type": "git",
    "url": "https://github.com/josStorer/genshin-ts"
  },
  "keywords": [
    "genshin",
    "genshin-ts",
    "typescript",
    "compiler"
  ],
  "license": "MIT",
  "bin": {
    "gsts": "bin/gsts.mjs"
  },
  "main": "./dist/src/index.js",
  "types": "./types/gsts/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/gsts/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./eslint": {
      "types": "./dist/src/eslint/index.d.ts",
      "default": "./dist/src/eslint/index.js"
    },
    "./eslint.globals.mjs": "./eslint.globals.mjs",
    "./compiler/*": {
      "types": "./dist/src/compiler/*.d.ts",
      "default": "./dist/src/compiler/*.js"
    },
    "./injector/*": {
      "types": "./dist/src/injector/*.d.ts",
      "default": "./dist/src/injector/*.js"
    },
    "./runtime/*": {
      "types": "./dist/src/runtime/*.d.ts",
      "default": "./dist/src/runtime/*.js"
    },
    "./definitions/*": {
      "types": "./dist/src/definitions/*.d.ts",
      "default": "./dist/src/definitions/*.js"
    },
    "./configs/ts-plugin": "./configs/ts-plugin/index.cjs",
    "./configs/ts-plugin/index.cjs": "./configs/ts-plugin/index.cjs",
    "./configs/*": "./configs/*",
    "./tsconfig/*": "./configs/tsconfig/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "types",
    "configs",
    "eslint.globals.mjs",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pretest": "node scripts/clean-tests.mjs",
    "test": "npm run build && tsx scripts/generate-node-gia-tests.ts && tsx scripts/generate-enum-gia-tests.ts && node ./bin/gsts.mjs -c gsts.test.config.ts && tsx scripts/nodegraph/assert-enum-combinations.ts",
    "quicktest": "npm run build && node ./bin/gsts.mjs -c gsts.test.config.ts",
    "test:eslint": "tsx tests/eslint/node-graph-rules.test.ts",
    "test:injector": "tsx tests/injector/client-graph-injection.test.ts && tsx tests/injector/batch-injection.test.ts && tsx tests/injector/gil-file-transaction.test.ts && tsx tests/injector/gil-artifacts.test.ts && tsx tests/injector/prefab-extraction-equivalence.test.ts",
    "test:prefab-equivalence": "tsx tests/injector/prefab-extraction-equivalence.test.ts",
    "test:package-api": "npm run build && tsc -p tests/package-consumer/tsconfig.json",
    "test:gs-precompile": "npm run build && node scripts/assert-gs-precompile.mjs",
    "benchmark:injector": "tsx scripts/benchmark-injector.ts",
    "test:stage-bootstrap": "npm run build && tsx scripts/assert-stage-event-prelude.ts",
    "test:client-transform": "npm run build && tsx scripts/client-nodegraph/assert-client-ts-transform.ts && tsx scripts/client-nodegraph/smoke-minimal-client-gia.ts && tsx scripts/client-nodegraph/smoke-generic-specialization.ts && tsx scripts/client-nodegraph/smoke-dict-reflect-nodes.ts && tsx scripts/client-nodegraph/smoke-local-variables.ts && tsx scripts/client-nodegraph/smoke-inline-id-values.ts && tsx scripts/client-nodegraph/smoke-ordered-start-pins.ts && tsx scripts/client-nodegraph/smoke-client-exec-bindings.ts && tsx scripts/client-nodegraph/smoke-enum-match.ts",
    "test:client-generics": "npm run build && tsx scripts/client-nodegraph/smoke-generic-specialization.ts",
    "test:client-static": "npm run build && tsx scripts/client-nodegraph/smoke-client-static-metadata.ts",
    "test:client:definitions": "tsx ./scripts/check-client-definitions-consistency.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node scripts/postbuild.mjs",
    "pack": "npm run build && npm pack",
    "gen": "tsx ./scripts/generate-definitions.ts && prettier --write src/definitions/**/*.ts",
    "gen:client:modes": "tsx ./scripts/client-nodegraph/build-client-node-mode-data.ts",
    "gen:client:static": "tsx ./scripts/client-nodegraph/extract-client-node-static-metadata.ts",
    "gen:server:metadata": "tsx ./scripts/server-nodegraph/generate-server-node-metadata.ts",
    "gen:server:pin-comments": "tsx ./scripts/nodegraph/sync-server-pin-comments.ts",
    "gen:server:static": "tsx ./scripts/client-nodegraph/extract-client-node-static-metadata.ts --server && npm run gen:server:metadata",
    "gen:editor:names": "tsx ./scripts/nodegraph/extract-mihoyo-editor-names.ts && tsx ./scripts/nodegraph/sync-mihoyo-editor-display-names.ts --write && prettier --write src/thirdparty/Genshin-Impact-Miliastra-Wonderland-Code-Node-Editor-Pack/node_data/node_pin_records.ts src/thirdparty/Genshin-Impact-Miliastra-Wonderland-Code-Node-Editor-Pack/node_data/client_node_metadata.ts resources/mihoyo_editor_names.json",
    "test:editor:names": "tsx ./scripts/nodegraph/sync-mihoyo-editor-display-names.ts && tsx ./scripts/nodegraph/audit-mihoyo-editor-names.ts && tsx ./scripts/nodegraph/sync-server-pin-comments.ts --check",
    "gen:client": "node --import tsx ./scripts/client-nodegraph/extract-client-node-metadata.ts && tsx ./scripts/nodegraph/sync-mihoyo-editor-display-names.ts --write && node --import tsx ./scripts/client-nodegraph/generate-client-nodegraph-modules.ts && prettier --write src/definitions/client_*.ts src/thirdparty/Genshin-Impact-Miliastra-Wonderland-Code-Node-Editor-Pack/node_data/client_*.ts",
    "gen:client:manual": "tsx ./scripts/client-nodegraph/generate-client-node-manual-tests.ts && prettier --write tests/manual/client-nodes/*.ts tests/manual/client-nodes/_coverage.json",
    "test:client:manual": "node ./bin/gsts.mjs tests/manual/client-nodes/beyond.ts -c ./gsts.test.config.ts --noinject && node ./bin/gsts.mjs tests/manual/client-nodes/classic.ts -c ./gsts.test.config.ts --noinject && tsx ./scripts/client-nodegraph/assert-client-node-manual-tests.ts",
    "test:client:fixed-pins": "node ./bin/gsts.mjs tests/manual/client-nodes/fixed-pin-regression.ts -c ./gsts.test.config.ts --noinject && tsx ./scripts/client-nodegraph/assert-client-fixed-pin-regression.ts",
    "test:server:metadata": "tsx ./scripts/server-nodegraph/generate-server-node-metadata.ts --check && tsx ./scripts/server-nodegraph/assert-server-generic-metadata.ts",
    "test:server:enum-equality": "node ./bin/gsts.mjs tests/enum_operator_equal.ts -c ./gsts.test.config.ts --noinject && tsx ./scripts/server-nodegraph/assert-server-enum-equality.ts",
    "test:enum-combinations": "npm run build && tsx scripts/nodegraph/assert-enum-combinations.ts",
    "test:server:latest": "npm run test:server:metadata && npm run build && npm run test:server:enum-equality && node ./bin/gsts.mjs tests/manual_verify_2026_07_server_nodes.ts -c ./gsts.test.config.ts --noinject && tsx ./scripts/server-nodegraph/assert-latest-server-nodes.ts",
    "smoke:client": "npm run build && node ./scripts/smoke-client-capability.mjs",
    "to-gs": "tsx ./src/compiler/ts_to_gs.ts",
    "tool:computer-control": "python ./scripts/tools/computer_control_server.py",
    "example": "npm run build && node ./bin/gsts.mjs",
    "dev": "npm run build && node ./bin/gsts.mjs dev"
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^24.10.1",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.6.2",
    "tsx": "^4.23.1"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.6.2",
    "chokidar": "^3.6.0",
    "commander": "^14.0.2",
    "esbuild": "^0.28.1",
    "fast-glob": "^3.3.3",
    "i18next": "^25.10.10",
    "os-locale": "^6.0.0",
    "picocolors": "^1.1.1",
    "protobufjs": "^7.6.5",
    "semver": "^7.7.2",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3",
    "undici": "^7.28.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.12"
  }
}
